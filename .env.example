# TypeSafe has no LangSmith gateway route; this must be a real TypeSafe key.
TYPESAFE_API_KEY=

# Routes the text_model's chat calls through the LangSmith gateway instead of a
# provider key. Requires LANGSMITH_GATEWAY=true below; OPENAI_API_KEY is not needed.
LANGSMITH_API_KEY=
LANGSMITH_GATEWAY=true
